{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkplacehealth.org/schemas/v0.2/OHEpisode.json",
  "title": "OWHS OHEpisode v0.2",
  "description": "Management-facing envelope of an OH interaction. Carries NO clinical content.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ohEpisodeId": {
      "type": "string",
      "minLength": 1
    },
    "pseudonymId": {
      "type": "string",
      "pattern": "^owhs:pseudo:[0-9a-f]{16,64}$"
    },
    "referralReason": {
      "type": "string",
      "enum": [
        "long-term-absence",
        "short-term-frequent",
        "fitness-for-task",
        "adjustments-advice",
        "return-to-work",
        "health-surveillance",
        "pre-placement",
        "dse",
        "other"
      ],
      "$comment": "codelist:oh-referral-reason@0.1.0"
    },
    "referralDate": {
      "type": "string",
      "format": "date"
    },
    "assessmentType": {
      "type": "string",
      "enum": [
        "management-referral",
        "health-surveillance",
        "pre-placement",
        "dse",
        "ill-health-retirement"
      ],
      "$comment": "codelist:oh-assessment-type@0.1.0"
    },
    "assessmentDate": {
      "type": "string",
      "format": "date"
    },
    "fitnessOpinion": {
      "type": "string",
      "enum": [
        "fit",
        "fit-with-adjustments",
        "unfit",
        "not-assessed"
      ],
      "$comment": "codelist:fitness-opinion@0.1.0 — the released categorical opinion only"
    },
    "recommendationTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "phased-return",
          "altered-hours",
          "amended-duties",
          "workplace-adaptations"
        ]
      },
      "uniqueItems": true,
      "$comment": "codelist:rtw-adjustment@0.1.0 — types only"
    },
    "opinionReleasedToEmployer": {
      "type": "boolean",
      "$comment": "consent flag; MUST be true for fitnessOpinion to be present"
    },
    "linkedAbsenceEpisodeId": {
      "type": "string"
    },
    "ext": {
      "type": "object",
      "$comment": "Extension namespaces and values are structurally checked. The named identifier keys are prohibited recursively; OHEpisode also prohibits its named clinical-content keys recursively. This is not detection of identifiers or clinical meaning hidden in allowed keys or values. All extensions remain subject to P1-P5 and their applicable profile. A core-only pass does not establish profile or Level 3 conformance.",
      "propertyNames": {
        "pattern": "^owhs-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/owhsExtensionObject"
      }
    }
  },
  "required": [
    "ohEpisodeId",
    "pseudonymId",
    "referralReason",
    "referralDate",
    "opinionReleasedToEmployer"
  ],
  "allOf": [
    {
      "$comment": "BOUNDARY: no clinical content permitted",
      "not": {
        "anyOf": [
          {
            "required": [
              "diagnosis"
            ]
          },
          {
            "required": [
              "clinicalCauseCode"
            ]
          },
          {
            "required": [
              "symptoms"
            ]
          },
          {
            "required": [
              "testResults"
            ]
          },
          {
            "required": [
              "reportText"
            ]
          },
          {
            "required": [
              "history"
            ]
          }
        ]
      }
    },
    {
      "$comment": "CONSENT: fitnessOpinion requires opinionReleasedToEmployer=true",
      "if": {
        "required": [
          "fitnessOpinion"
        ]
      },
      "then": {
        "properties": {
          "opinionReleasedToEmployer": {
            "const": true
          }
        },
        "required": [
          "opinionReleasedToEmployer"
        ]
      }
    },
    {
      "$comment": "P1 (no direct identifiers) is enforced structurally by \"additionalProperties\": false on this object and on every nested object, which rejects any property not declared here, including name, nino, email, dateOfBirth and address. A key-based rule cannot reach an identifier written into the value of a permitted string field; that part of P1 is a producer obligation, stated in the privacy profile. The previous allOf member duplicated additionalProperties and claimed to forbid identifiers \"anywhere\", which was not true of values."
    }
  ],
  "$defs": {
    "owhsExtensionObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "name",
            "nino",
            "email",
            "dateOfBirth",
            "address",
            "diagnosis",
            "clinicalCauseCode",
            "symptoms",
            "testResults",
            "reportText",
            "history"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/owhsExtensionValue"
      }
    },
    "owhsExtensionValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owhsExtensionValue"
          }
        },
        {
          "$ref": "#/$defs/owhsExtensionObject"
        }
      ]
    }
  }
}
